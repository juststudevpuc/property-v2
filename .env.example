# ============================================================
# The Creators HQ — Environment Variables Template
# Copy this file to .env or .env.local and update values
# ============================================================

# Backend API / CMS Base URL (e.g. Strapi, Payload, Headless WordPress, or Custom Node.js API)
VITE_API_BASE_URL=https://api.thecreatorshq.com/v1

# Canonical Site URL
VITE_SITE_URL=https://thecreatorshq.com

# Contact Form & Private Preview Webhook Endpoint
VITE_CONTACT_WEBHOOK_URL=https://api.thecreatorshq.com/v1/inquiries

# Read-Only Public CMS API Token (if using authenticated CMS headless endpoints)
VITE_CMS_READ_TOKEN=your_public_read_token_here

# Google Analytics / Google Tag Manager (optional)
VITE_GA_TRACKING_ID=
VITE_GTM_ID=
